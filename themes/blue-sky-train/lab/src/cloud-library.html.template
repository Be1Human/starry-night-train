,0 12px,12px -12px,-12px 0;border-radius:7px;aspect-ratio:3/2}.asset img{width:100%;height:100%;object-fit:contain;display:block}.meta{display:flex;justify-content:space-between;gap:15px;align-items:center;margin-top:14px}.meta strong{font-size:14px;font-weight:550}.meta a{font-size:12px}.small{font-size:11px}.rules{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.rule{border-top:2px solid #467a94;padding:16px 0}.rule b{font-weight:550;font-size:14px}.rule p{font-size:12px}.table-wrap{overflow:auto}table{border-collapse:collapse;min-width:650px;width:100%;font-size:12px}th,td{text-align:left;border-bottom:1px solid var(--line);padding:13px 12px;line-height:1.9}th{color:#9cbdcf;font-weight:500}td{color:#b9cdd9}details{border:1px solid var(--line);border-radius:8px;margin:20px 0;overflow:hidden}summary{padding:14px;cursor:pointer;font-size:13px}pre{margin:0;padding:18px;background:#0b1620;overflow:auto;max-height:400px;font:11px/1.7 Consolas,monospace;color:#aed1e1}footer{margin-top:28px;border-top:1px solid var(--line);padding-top:18px;font-size:11px;color:#809dad;line-height:1.8}[hidden]{display:none!important}@media(max-width:700px){main{padding:15px}h1{font-size:21px}header{align-items:start}.grid{grid-template-columns:1fr}.rules{grid-template-columns:1fr}.toolbar{gap:10px}input{width:64px}.card{padding:14px}}
.comparison{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin:16px 0 12px}.comparison button[aria-pressed=true]{background:#a9dcee;color:#123548}.comparison label{margin-left:auto}.comparison input{width:auto}.scene>img{position:absolute;inset:0;width:100%;height:100%;object-fit:fill}.guides{position:absolute;inset:0;pointer-events:none}.guide{position:absolute;inset-inline:0;border-top:1px dashed #ffe0a4}.guide span{position:absolute;right:8px;bottom:4px;background:#162c3ad9;color:#ffe4ae;font:10px/1.5 Consolas,"Microsoft YaHei",sans-serif;padding:2px 5px}.train-guide{position:absolute;left:58.98%;top:58.8%;width:15.1%;height:3.6%;border:1px solid #ffe0a4}.frame-label{position:absolute;top:10px;left:12px;background:#112b3cc9;padding:4px 7px;font-size:11px;color:#e7f3fa;pointer-events:none}.scale-notes{display:flex;gap:18px;flex-wrap:wrap;padding:13px 0;border-bottom:1px solid var(--line);font-size:12px;color:#9ebbc9}.scale-notes strong{color:#dcebf2;font-weight:500}button,select{font-family:inherit;font-size:12px}
.scene>canvas{image-rendering:auto}.bridge-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;padding:0 16px 16px}.bridge-view{min-width:0}.bridge-view b{display:block;font-size:11px;font-weight:500;color:#bad5e3;margin:0 0 8px}.bridge-view canvas{width:100%;height:auto;aspect-ratio:75/22;image-rendering:pixelated;border:1px solid var(--line);border-radius:5px}.bridge-caption{font-size:11px;margin:0;padding:0 16px 15px}@media(max-width:700px){.bridge-grid{grid-template-columns:1fr}}
